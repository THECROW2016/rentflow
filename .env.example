# Local SQLite (dev only — switch schema provider back to sqlite if using this)
# DATABASE_URL="file:./dev.db"

# Production / Railway — PostgreSQL (required)
DATABASE_URL="postgresql://user:password@host:5432/railway"

# Required in production — generate with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Public app URL (used for absolute links if needed)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
